# Browser-safe Supabase project values only. The publishable key is public and relies on RLS.
# Use the project root URL here, not the /rest/v1 API URL. These same names are used in Vercel.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
